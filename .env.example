# ---- The Maze: environment ----
# Leave everything blank to run the free, no-API-key demo (mock story + storyboard cards).

# Story planner (Claude). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model for the planner. Default: claude-opus-5
PLANNER_MODEL=claude-opus-5

# Video + image generation (fal.ai). Get a key at https://fal.ai/dashboard/keys
FAL_KEY=
# Video model endpoint on fal (image-to-video). See docs/03-fal-video-model.md
FAL_VIDEO_MODEL=
# Image model endpoint on fal used to make character-locked keyframes. See docs/02-character-consistency.md
FAL_IMAGE_MODEL=
# Clip length requested from the video model, in seconds (must divide the 45 s beat)
CLIP_SECONDS=15
# Video quality: 768p or 1080p
VIDEO_RESOLUTION=1080p

# Speculation: none | keyframes | full  (how much of the next beat to pre-generate before the vote closes)
SPECULATION=keyframes

# Mock mode knobs (used when FAL_KEY is blank)
MOCK_GENERATION_MS=6000
MOCK_FAILURE_RATE=0

# Web server
PORT=8787
# Credits every new viewer gets for free
STARTER_CREDITS=3
# Credits one vote costs
VOTE_COST=1

# Optional: Twitch chat as a vote source (viewers type 1/2/3). Anonymous read; no token needed.
TWITCH_CHANNEL=
# Optional: TikTok LIVE username for the (unofficial) chat/gift connector
TIKTOK_USERNAME=

# Optional: RTMP playout (needs ffmpeg installed). Example: rtmp://live.twitch.tv/app/<stream-key>
RTMP_URL=

# Optional: Stripe webhook secret for credit purchases
STRIPE_WEBHOOK_SECRET=

# Content rules for the writer: tiktok (no weapons or fights on screen; TikTok LIVE rules) | standard
CONTENT_MODE=tiktok
# Vote counting: value (gift/credit value decides; viewers can add more) | count (one vote per person)
VOTE_MODE=value
# Display rate used to show coin totals in dollars (TikTok coins cost roughly $0.0105–0.0135 each)
COIN_USD=0.0125
# The three gifts that select an option on TikTok LIVE (names as TikTok shows them)
TIKTOK_GIFT_A=Rose
TIKTOK_GIFT_B=GG
TIKTOK_GIFT_C=Ice Cream Cone
# Euler Stream sign-server key for tiktok-live-connector (free tier works for small rooms)
EULER_API_KEY=
# Aspect ratio of the show: 9:16 for TikTok LIVE (portrait), 16:9 for a website/Twitch
ASPECT=9:16
# Use the faster Turbo tier for the one clip the audience is waiting on (true/false)
TURBO_FOR_DEADLINE=false

# ---- Renderer ----
# clips    = 15-second H3 Max clips from character-locked keyframes (default; best consistency)
# director = one continuous H3 Max Director stream steered by prompts (minimax/h3-max/director; see docs/08-director-mode.md)
RENDERER=clips
# Director settings (only used when RENDERER=director). The page that holds the stream is /?tv=1&director=1&token=<DIRECTOR_TOKEN>
DIRECTOR_TOKEN=change-me
DIRECTOR_RESOLUTION=768p
DIRECTOR_MEMORY=12
# fal caps sessions at 120 s unless they approve longer for your account; the page re-opens sessions before the cap
DIRECTOR_SESSION_SECONDS=120
DIRECTOR_PREWARM_SECONDS=20

# ---- Vote timing ----
# The vote opens this many seconds into each 45-second beat (15 = the moment clip 2 starts; never earlier)
VOTE_OPENS_AT_SECONDS=15
# How long the audience has to vote. Default 10 → closes with 20 s left, the render budget for the winner's clip.
# With SPECULATION=full or RENDERER=director the vote may close as late as 3 s before the beat ends (e.g. VOTE_OPENS_AT_SECONDS=30).
VOTE_SECONDS=10
